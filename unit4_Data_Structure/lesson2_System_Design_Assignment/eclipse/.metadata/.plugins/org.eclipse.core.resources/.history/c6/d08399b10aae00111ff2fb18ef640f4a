#include "CA.h"
//STATE Pointer to function
void (*CA_state)();

void US_Set_distance(int d);
int US_Get_distance_random(int l,int r , int count);

//varibles
int CA_speed= 0, CA_distance= 0, CA_threshold= 50 ;

STATE_define(CA_waiting){

	//state_Name
	CA_State_id = CA_waiting;
	printf("CA_Waiting State:CA_speed= %d, CA_distance= %d\n" ,CA_speed,CA_distance );

	//State_Action
	DC_motor(CA_speed);
	//US_GET_distance(CA_distance)
	printf("CA_Waiting State:CA_speed= %d, CA_distance= %d\n" ,CA_speed,CA_distance );
}

STATE_define(CA_driving){

	//state_Name
	CA_State_id = CA_driving;
	//State_Action
	CA_speed=30;
	//DC_Motor(CA_speed)
	//Event_Check
	CA_distance = US_Get_distance_random(45,55,1);
	(CA_distance<=CA_threshold) ? (CA_state = STATE(CA_waiting)) :(CA_state = STATE(CA_driving));
	//US_GET_distance(CA_distance)
	printf("CA_Waiting State:CA_speed= %d, CA_distance= %d\n" ,CA_speed,CA_distance );

}

void US_Set_distance(int d){
	CA_distance = d ;
	//Event_Check
	(CA_distance<=CA_threshold) ? (CA_state = STATE(CA_waiting)) :(CA_state = STATE(CA_driving));
	printf("US------distance=%d ------->CA", CA_distance);
}


int US_Get_distance_random(int l,int r , int count){
	int i ;
	for (i=0;i<count;i++){
		int rand_num=(rand()%(r-l+1)+1);
		return rand_num;
	}
}



