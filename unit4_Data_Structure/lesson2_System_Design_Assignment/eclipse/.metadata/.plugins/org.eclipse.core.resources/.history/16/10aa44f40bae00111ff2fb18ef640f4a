#include "CA.h"

void setup (){

	//init all the drivers
	//init IRQ
	//init HAL US_Driver DC_Driver
	//init BLOCK
	US_init();
	DC_init();
	//set States pointer for each Block
	CA_state = STATE(CA_waiting);
	US_state = STATE(US_busy);
	DC_state = STATE(DC_ideal);
}
int main()
{
	volatile int i;
	setup();
	while(1)
	{
		US_state();
		CA_state();
		DC_state();
		for(i=0;i<1000;i++);

	}
}
