//effective data
struct Sdata{
	int ID;
	char name[40];
	float height;
};

//linked list node
struct SStudent{
	struct Sdata student;
	struct SStudent* PNextStudent;
};

struct SStudent* gpFirstStudent=NULL;

void AddStudent(){
