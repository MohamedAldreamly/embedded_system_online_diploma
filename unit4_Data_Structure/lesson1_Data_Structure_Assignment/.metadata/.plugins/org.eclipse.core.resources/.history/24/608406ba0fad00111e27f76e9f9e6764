#include"linked_list.h"
void Get_Nth(){
	char temp_text[40];
	gets(temp_text);
	struct SStudent* pCurrentStudent = gpFirstStudent;
	int count =0 ;

	if (gpFirstStudent==NULL){
		DPRINTF ("\n Empty list");

	while(atio(temp_text) == count){
		pCurrentStudent = pCurrentStudent->PNextStudent;
		count++;
	}
	DPRINTF("\n record number %d",count+1);
	DPRINTF("\n \t ID: %d",pCurrentStudent->student.ID);
	DPRINTF("\n \t name: %s",pCurrentStudent->student.name);
	DPRINTF("\n \t ID: %f",pCurrentStudent->student.height);
}


void Get_Length(){

