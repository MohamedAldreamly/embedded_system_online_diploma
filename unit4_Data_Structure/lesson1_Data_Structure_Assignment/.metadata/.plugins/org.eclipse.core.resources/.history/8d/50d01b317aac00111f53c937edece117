#ifndef LIFO_H_
#define LIFO_H_

//type definitions

typedef struct {
	unsigned int 	length;
	unsigned int 	count;
	unsigned int*	base;
	unsigned int*	head;
}LIFO_Buf_t;

typedef enum{
	LIFO_no_error,
	LIFO_full,
	LIFO_empty,
	LIFO_Null,
	LIFO_over_stack
}LIFO_status;

// APIs

LIFO_status LIFO_Add_item (LIFO_status* lifo_buf , unsigned int item );
LIFO_status LIFO_get_item (LIFO_status* lifo_buf , unsigned int* item );
LIFO_status LIFO_init (LIFO_status* lifo_buf , unsigned int* buf, unsigned int length );

#endif /* LIFO_H_ */
