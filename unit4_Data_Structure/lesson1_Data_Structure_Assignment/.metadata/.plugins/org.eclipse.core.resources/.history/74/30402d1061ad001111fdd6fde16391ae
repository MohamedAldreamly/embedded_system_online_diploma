}

void Reverse_List(){
	struct SStudent* prev_Ptr = NULL;
	struct SStudent* curr_Ptr = gpFirstStudent;
	struct SStudent* next_Ptr = NULL;

	if (gpFirstStudent == NULL)
	{
		DPRINTF("\n Empty list");
		return;
	}

	while(curr_Ptr != NULL){
		next_Ptr = curr_Ptr->pNextStudent;
		curr_Ptr->pNextStudent = prev_Ptr;
		prev_Ptr = curr_Ptr;
		curr_Ptr = next_Ptr;
	}
	gpFirstStudent = prev_Ptr;

}
