void Get_Nth_From_The_End(){
	struct SStudent* main_Ptr = gpFirstStudent;
	struct SStudent* ref_Ptr = gpFirstStudent;
	if (gpFirstStudent == NULL)
	{
	    DPRINTF("\n Empty list");
	    return;
	}

	char temp_text[40];
	DPRINTF("\n Enter Nth Node: ");
	gets(temp_text);
	int nth =atoi(temp_text) ;
	int count= 0;

	while (ref_Ptr!=NULL ){

		if (count<=nth){// dont move main_Ptr
			ref_Ptr =ref_Ptr->pNextStudent;
		}else // move main_Ptr
		{
			ref_Ptr = ref_Ptr->pNextStudent;
			main_Ptr =main_Ptr->pNextStudent;
		}
		count++;

	}
	DPRINTF("\n \t ID: %d",main_Ptr->student.ID);
	DPRINTF("\n \t name: %s",main_Ptr->student.name);
	DPRINTF("\n \t height: %f",main_Ptr->student.height);

}

void Detect_loop(){
	int count = 0;
	struct SStudent* main_Ptr = gpFirstStudent;
	struct SStudent* ref_Ptr = gpFirstStudent;
	if (gpFirstStudent == NULL)
	{
		DPRINTF("\n Empty list");
		return;
	}

	while(ref_Ptr != NULL && ref_Ptr->pNextStudent != NULL){

		ref_Ptr =ref_Ptr->pNextStudent->pNextStudent;
		main_Ptr =main_Ptr->pNextStudent;
		count++;
	}

	DPRINTF("\n record number %d",count+1);
	DPRINTF("\n \t ID: %d",main_Ptr->student.ID);
	DPRINTF("\n \t name: %s",main_Ptr->student.name);
	DPRINTF("\n \t height: %f",main_Ptr->student.height);

}

